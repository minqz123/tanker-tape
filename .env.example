# Copy to .env and fill in. Never commit .env.

# EIA API v2 - free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FRED - free key: https://fredaccount.stlouisfed.org/apikeys
# Only needed for the FRED fallback price source.
FRED_API_KEY=

# aisstream.io - free key via GitHub signup: https://aisstream.io/
# Server-side use only; browser connections are not permitted by the provider.
AISSTREAM_API_KEY=

# Storage roots (optional; defaults are relative to the repo root)
TANKER_TAPE_DATA_DIR=data
TANKER_TAPE_DUCKDB_PATH=data/tanker_tape.duckdb

# Logging
TANKER_TAPE_LOG_LEVEL=INFO
